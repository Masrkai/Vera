import { Button, LineEdit, CheckBox, ListView, VerticalBox } from "std-widgets.slint";

export global Theme {
    in-out property <string> theme-mode: "dark";
    in-out property <color> bg-color: #121212;
    in-out property <color> surface-color: #1e1e1e;
    in-out property <color> text-color: #e0e0e0;
    in-out property <color> text-muted: #a0a0a0;
    in-out property <color> border-color: #333333;
    in-out property <color> accent-color: #3b82f6;
    in-out property <color> preview-bg: #181818;
}

component ThemedButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: 4px;
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-color : (touch.pressed ? Theme.accent-color : (touch.has-hover ? Theme.accent-color : Theme.border-color));
    background: !root.enabled ? Theme.preview-bg : (touch.pressed ? Theme.accent-color : (touch.has-hover ? Theme.preview-bg : Theme.surface-color));

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-muted : (touch.pressed ? #ffffff : Theme.text-color);
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ThemedDropdown inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    height: 30px;
    min-width: 120px;
    border-radius: 4px;
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-color : (touch.has-hover ? Theme.accent-color : Theme.border-color);
    background: !root.enabled ? Theme.preview-bg : (touch.has-hover ? Theme.preview-bg : Theme.surface-color);

    property <int> visible-items: min(6, model.length);
    property <string> current-label: (current-index >= 0 && current-index < model.length) ? model[current-index] : "";

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.current-label;
            color: !root.enabled ? Theme.text-muted : Theme.text-color;
            font-size: 13px;
            horizontal-stretch: 1;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: popup.is-open ? "▴" : "▾";
            color: !root.enabled ? Theme.text-muted : Theme.text-color;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: max(root.width, 120px);
        height: root.visible-items * 28px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface-color;
            border-width: 1px;
            border-color: Theme.border-color;
            border-radius: 4px;
            drop-shadow-color: #0006;
            drop-shadow-blur: 8px;

            VerticalLayout {
                padding: 4px;
                for value[index] in root.model : Rectangle {
                    height: 26px;
                    border-radius: 3px;
                    background: (index == root.current-index) ? Theme.accent-color : (item-touch.has-hover ? Theme.preview-bg : transparent);
                    Text {
                        text: value;
                        color: (index == root.current-index) ? #ffffff : Theme.text-color;
                        font-size: 13px;
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.selected(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

component ThemedCheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text: "";

    height: 24px;
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.border-color;
            background: checked ? Theme.accent-color : Theme.surface-color;

            if checked: Text {
                text: "✓";
                color: #ffffff;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        Text {
            text: root.text;
            color: Theme.text-color;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
        }
    }
}

component ThemedLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    callback edited(string);

    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border-color;
    background: Theme.surface-color;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        TextInput {
            text <=> root.text;
            color: Theme.text-color;
            vertical-alignment: center;
            font-size: 13px;
            edited() => { root.edited(root.text); }
        }
    }
}

export struct ExifRow {
    tag: string,
    value: string,
    is-common: bool,
}

export component ExifDataManager inherits Window {
    title: "Vera";
    preferred-width: 950px;
    preferred-height: 750px;
    default-font-size: 14px;
    default-font-family: root.system-font-family;

    // --- Theme & Font Properties ---
    in-out property <string> system-font-family: "";
    in-out property <string> theme-mode <=> Theme.theme-mode;
    in-out property <color> bg-color <=> Theme.bg-color;
    in-out property <color> surface-color <=> Theme.surface-color;
    in-out property <color> text-color <=> Theme.text-color;
    in-out property <color> text-muted <=> Theme.text-muted;
    in-out property <color> border-color <=> Theme.border-color;
    in-out property <color> accent-color <=> Theme.accent-color;
    in-out property <color> preview-bg <=> Theme.preview-bg;
    in-out property <[string]> theme-names: [];
    in-out property <int> theme-index: 0;

    // --- Properties set from Python ---
    in-out property <string> current-file-name: "";
    property <bool> has-image: root.current-file-name != "";
    in-out property <image>  preview-source;
    in-out property <image>  maximized-preview-source;
    in-out property <bool>   show-maximized-dialog: false;
    in-out property <bool>   has-gps: false;
    in-out property <bool>   preserve-original: false;
    in-out property <bool>   batch-preserve-original: false;
    in-out property <float>  batch-progress: 0.0;
    in-out property <string> status-message: "Ready";
    in-out property <[ExifRow]>  exif-model;
    in-out property <[string]>   batch-model;
    in-out property <[string]>   batch-status-model;
    in property <length> min-font-size: 14px;

    // --- Callbacks handled in Python ---
    callback request-open-image();
    callback request-open-images();
    callback request-maximize-image();
    callback load-image(string);
    callback clear-batch-list();
    callback start-batch-process();
    callback open-gps-location();
    callback open-esri-satellite();
    callback save-exif-changes();
    callback delete-exif();
    callback apply-filter(string);
    callback exif-value-edited(int, string);
    callback set-theme(int);

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.bg-color;

        VerticalLayout {
            padding: 10px;
            spacing: 6px;

        // ── Single image section ──────────────────────────────────────
        HorizontalLayout {
            spacing: 12px;

            // FIX 1: Image preview that actually renders preview-source
            Rectangle {
                width: 260px;
                height: 180px;
                border-width: 1px;
                border-color: root.border-color;
                border-radius: 4px;
                clip: true;
                background: root.preview-bg;

                Image {
                    source: root.preview-source;
                    width: parent.width;
                    height: parent.height;
                    image-fit: contain;
                }

                if root.current-file-name == "": Text {
                    text: "No image loaded";
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: parent.width;
                    height: parent.height;
                    color: root.text-muted;
                    font-size: max(root.min-font-size, 12px);
                }

                // Square icon hinting maximize feature
                if root.current-file-name != "": Rectangle {
                    x: parent.width - 28px;
                    y: 4px;
                    width: 24px;
                    height: 24px;
                    background: #2228;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: #fff6;

                    Text {
                        text: "⤢";
                        color: #ffffff;
                        font-size: 14px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }

                    TouchArea {
                        enabled: root.has-image;
                        clicked => {
                            root.request-maximize-image();
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Single Image"; font-weight: 700; color: root.text-color; vertical-alignment: center; }
                    ThemedDropdown {
                        model: root.theme-names;
                        current-index <=> root.theme-index;
                        selected(index) => { root.set-theme(index); }
                        min-width: 140px;
                    }
                }
                Text {
                    text: root.current-file-name == "" ? "No file selected" : root.current-file-name;
                    color: root.text-color;
                    overflow: elide;
                }

                HorizontalLayout {
                    spacing: 6px;
                    ThemedButton { text: "Open Image"; clicked => { root.request-open-image(); } }
                    ThemedButton {
                        text: "Open GPS Location";
                        enabled: root.has-image && root.has-gps;
                        clicked => { root.open-gps-location(); }
                    }
                    ThemedButton {
                        text: "ESRI Satellite";
                        enabled: root.has-image && root.has-gps;
                        clicked => { root.open-esri-satellite(); }
                    }
                }

                HorizontalLayout {
                    spacing: 6px;
                    ThemedCheckBox { text: "Preserve original"; checked <=> root.preserve-original; }
                    ThemedButton   { text: "Delete EXIF"; enabled: root.has-image; clicked => { root.delete-exif(); } }
                }
            }
        }

        // ── Batch section ─────────────────────────────────────────────
        Text { text: "Batch Processing"; font-weight: 700; color: root.text-color; }

        HorizontalLayout {
            spacing: 6px;
            ThemedButton { text: "Add Images";  clicked => { root.request-open-images(); } }
            ThemedButton { text: "Clear List";  clicked => { root.clear-batch-list(); } }
            ThemedButton { text: "Start Batch"; clicked => { root.start-batch-process(); } }
        }

        ThemedCheckBox { text: "Preserve originals"; checked <=> root.batch-preserve-original; }

        Text { text: "Queue:"; color: root.text-color; }

        // FIX 3: clip + constrained width on list items
        ListView {
            height: 80px;
            for item in root.batch-model: Rectangle {
                height: 22px;
                width: parent.width;
                clip: true;
                Text { text: item; color: root.text-color; vertical-alignment: center; overflow: elide; width: parent.width; }
            }
        }

        Text { text: "Results:"; color: root.text-color; }

        ListView {
            height: 60px;
            for item in root.batch-status-model: Rectangle {
                height: 22px;
                width: parent.width;
                clip: true;
                Text { text: item; color: root.text-color; vertical-alignment: center; overflow: elide; width: parent.width; }
            }
        }

        // ── EXIF table ────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: "EXIF Data";
                font-weight: 700;
                color: root.text-color;
                vertical-alignment: center;
            }
            ThemedLineEdit {
                placeholder-text: "Filter tags…";
                edited(text) => { root.apply-filter(text); }
                horizontal-stretch: 1;
            }
            ThemedButton {
                text: "Save Changes";
                enabled: root.has-image;
                clicked => { root.save-exif-changes(); }
            }
        }

        // FIX 2 + 3: LineEdit for editing, clip to prevent overflow
        Rectangle {
            clip: true;
            vertical-stretch: 1;

            ListView {
                for row[idx] in root.exif-model: HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    padding-left: 4px;
                    padding-right: 4px;

                    // Tag column — fixed width, clipped
                    Rectangle {
                        width: 180px;
                        clip: true;
                        Text {
                            text: row.tag;
                            font-weight: row.is-common ? 700 : 400;
                            color: root.text-color;
                            vertical-alignment: center;
                            width: parent.width;
                            overflow: elide;
                        }
                    }

                    // Value column — editable, stretches, clipped
                    Rectangle {
                        clip: true;
                        horizontal-stretch: 1;

                        ThemedLineEdit {
                            text: row.value;
                            edited(new-text) => {
                                root.exif-value-edited(idx, new-text);
                            }
                            width: parent.width;
                        }
                    }
                }
            }
        }

        // ── Status bar ────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 8px;
            height: 20px;
            Text { text: root.status-message; color: root.text-color; vertical-alignment: center; font-size: max(root.min-font-size, 11px); }

            if root.batch-progress > 0.0 && root.batch-progress < 1.0: Rectangle {
                height: 14px;
                background: root.border-color;
                border-radius: 7px;
                Rectangle {
                    x: 0;
                    width: parent.width * root.batch-progress;
                    height: parent.height;
                    background: root.accent-color;
                    border-radius: 7px;
                }
            }
            }
        }
    }

    // Modal popup dialog for maximized image view
    if root.show-maximized-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000a;
        z: 100;

        TouchArea {
            clicked => {
                root.show-maximized-dialog = false;
            }
        }

        Rectangle {
            width: root.width * 0.85;
            height: root.height * 0.85;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.surface-color;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.border-color;
            clip: true;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.current-file-name;
                        font-weight: 700;
                        color: root.text-color;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                    ThemedButton {
                        text: "Close";
                        clicked => {
                            root.show-maximized-dialog = false;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: #111;
                    border-radius: 4px;
                    clip: true;

                    Image {
                        source: root.maximized-preview-source;
                        width: parent.width;
                        height: parent.height;
                        image-fit: contain;
                    }
                }
            }
        }
    }
}
