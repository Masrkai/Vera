import { Button, LineEdit, CheckBox, ListView, VerticalBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { ThemedButton, ThemedDropdown, ThemedCheckBox, ThemedLineEdit } from "components.slint";

export { Theme }

export struct ExifRow {
    tag: string,
    value: string,
    is-common: bool,
}

export component ExifDataManager inherits Window {
    title: "Vera";
    preferred-width: 950px;
    preferred-height: 750px;
    default-font-size: 14px;
    default-font-family: root.system-font-family;

    // --- Theme & Font Properties ---
    in-out property <string> system-font-family: "";
    in-out property <string> theme-mode <=> Theme.theme-mode;
    in-out property <color> bg-color <=> Theme.bg-color;
    in-out property <color> surface-color <=> Theme.surface-color;
    in-out property <color> text-color <=> Theme.text-color;
    in-out property <color> text-muted <=> Theme.text-muted;
    in-out property <color> border-color <=> Theme.border-color;
    in-out property <color> accent-color <=> Theme.accent-color;
    in-out property <color> preview-bg <=> Theme.preview-bg;
    in-out property <[string]> theme-names: [];
    in-out property <int> theme-index: 0;
    in-out property <int> work-mode: 0; // 0 = Single Image, 1 = Multiple Images

    // --- Properties set from Python ---
    in-out property <string> current-file-name: "";
    property <bool> has-image: root.current-file-name != "";
    in-out property <image>  preview-source;
    in-out property <image>  maximized-preview-source;
    in-out property <bool>   show-maximized-dialog: false;
    in-out property <bool>   show-delete-exif-dialog: false;
    in-out property <bool>   has-gps: false;
    in-out property <bool>   preserve-original: false;
    in-out property <bool>   batch-preserve-original: false;
    in-out property <float>  batch-progress: 0.0;
    in-out property <string> status-message: "Ready";
    in-out property <[ExifRow]>  exif-model;
    in-out property <[string]>   batch-model;
    in-out property <[string]>   batch-status-model;
    in property <length> min-font-size: 14px;
    in-out property <int> single-sub-mode: 0;
    in-out property <string> steg-secret-text: "";
    in-out property <string> steg-passphrase: "";
    in-out property <int> steg-method-index: 0;
    in-out property <[string]> steg-method-names: ["Metadata (EXIF)", "Pixel-Wise (LSB)", "Frequency-Wise (DCT)"];
    in-out property <string> steg-output-text: "";

    // --- Callbacks handled in Python ---
    callback request-open-image();
    callback request-open-images();
    callback request-maximize-image();
    callback load-image(string);
    callback clear-batch-list();
    callback start-batch-process();
    callback open-gps-location();
    callback open-esri-satellite();
    callback save-exif-changes();
    callback delete-exif();
    callback apply-filter(string);
    callback exif-value-edited(int, string);
    callback exif-tag-deleted(int);
    callback set-theme(int);
    callback steg-embed();
    callback steg-extract();

    Rectangle {
        width: 100%;
        height: 100%;
        background: root.bg-color;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            // ── Top Bar: Mode Selector & Theme Selector ───────────────
            HorizontalLayout {
                alignment: space-between;

                // Mode selector segmented control
                Rectangle {
                    height: 32px;
                    width: 240px;
                    background: root.surface-color;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: root.border-color;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.work-mode == 0 ? root.accent-color : transparent;
                            Text {
                                text: "Single Image";
                                color: root.work-mode == 0 ? #ffffff : root.text-color;
                                font-size: 13px;
                                font-weight: root.work-mode == 0 ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.work-mode = 0; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.work-mode == 1 ? root.accent-color : transparent;
                            Text {
                                text: "Multiple Images";
                                color: root.work-mode == 1 ? #ffffff : root.text-color;
                                font-size: 13px;
                                font-weight: root.work-mode == 1 ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.work-mode = 1; }
                            }
                        }
                    }
                }

                ThemedDropdown {
                    model: root.theme-names;
                    current-index <=> root.theme-index;
                    selected(index) => { root.set-theme(index); }
                    min-width: 140px;
                }
            }

            // ── Mode 0: Single Image Workspace ────────────────────────
            if root.work-mode == 0: VerticalLayout {
                spacing: 8px;
                vertical-stretch: 1;

                HorizontalLayout {
                    spacing: 12px;

                    // Image preview
                    Rectangle {
                        width: 220px;
                        height: 140px;
                        border-width: 1px;
                        border-color: root.border-color;
                        border-radius: 4px;
                        clip: true;
                        background: root.preview-bg;

                        Image {
                            source: root.preview-source;
                            width: parent.width;
                            height: parent.height;
                            image-fit: contain;
                        }

                        if root.current-file-name == "": Text {
                            text: "No image loaded";
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            width: parent.width;
                            height: parent.height;
                            color: root.text-muted;
                            font-size: max(root.min-font-size, 12px);
                        }

                        if root.current-file-name != "": Rectangle {
                            x: parent.width - 28px;
                            y: 4px;
                            width: 24px;
                            height: 24px;
                            background: #2228;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: #fff6;

                            Text {
                                text: "⤢";
                                color: #ffffff;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }

                            TouchArea {
                                enabled: root.has-image;
                                clicked => {
                                    root.request-maximize-image();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        vertical-stretch: 1;

                        Text {
                            text: root.current-file-name == "" ? "No file selected" : root.current-file-name;
                            color: root.text-color;
                            font-weight: 700;
                            overflow: elide;
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            ThemedButton { text: "Open Image"; clicked => { root.request-open-image(); } }
                            ThemedButton {
                                text: "GPS Location";
                                enabled: root.has-image && root.has-gps;
                                clicked => { root.open-gps-location(); }
                            }
                            ThemedButton {
                                text: "ESRI Satellite";
                                enabled: root.has-image && root.has-gps;
                                clicked => { root.open-esri-satellite(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 6px;
                            ThemedCheckBox { text: "Preserve original"; checked <=> root.preserve-original; }
                        }
                    }
                }

                // Sub-mode tab selector: EXIF Metadata vs Encryption vs Decryption
                Rectangle {
                    height: 32px;
                    width: 420px;
                    background: root.surface-color;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: root.border-color;

                    HorizontalLayout {
                        padding: 2px;
                        spacing: 2px;

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.single-sub-mode == 0 ? root.accent-color : transparent;
                            Text {
                                text: "EXIF Metadata";
                                color: root.single-sub-mode == 0 ? #ffffff : root.text-color;
                                font-size: 13px;
                                font-weight: root.single-sub-mode == 0 ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.single-sub-mode = 0; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.single-sub-mode == 1 ? root.accent-color : transparent;
                            Text {
                                text: "Encryption";
                                color: root.single-sub-mode == 1 ? #ffffff : root.text-color;
                                font-size: 13px;
                                font-weight: root.single-sub-mode == 1 ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.single-sub-mode = 1; }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 3px;
                            background: root.single-sub-mode == 2 ? root.accent-color : transparent;
                            Text {
                                text: "Decryption";
                                color: root.single-sub-mode == 2 ? #ffffff : root.text-color;
                                font-size: 13px;
                                font-weight: root.single-sub-mode == 2 ? 700 : 400;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => { root.single-sub-mode = 2; }
                            }
                        }
                    }
                }

                // EXIF table section for Single Image
                if root.single-sub-mode == 0: VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        spacing: 8px;
                        Text {
                            text: "EXIF Data";
                            font-weight: 700;
                            color: root.text-color;
                            vertical-alignment: center;
                        }
                        ThemedLineEdit {
                            placeholder-text: "Filter tags…";
                            edited(text) => { root.apply-filter(text); }
                            horizontal-stretch: 1;
                        }
                        Rectangle {
                            height: 30px;
                            min-width: 90px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: !root.has-image ? Theme.border-color : (del-btn-touch.pressed ? #dc2626 : (del-btn-touch.has-hover ? #ef4444 : #991b1b));
                            background: !root.has-image ? Theme.preview-bg : (del-btn-touch.pressed ? #b91c1c : (del-btn-touch.has-hover ? #dc2626 : #ef4444));

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    text: "Delete EXIF";
                                    color: !root.has-image ? Theme.text-muted : #ffffff;
                                    font-size: 13px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: center;
                                }
                            }

                            del-btn-touch := TouchArea {
                                enabled: root.has-image;
                                clicked => {
                                    root.show-delete-exif-dialog = true;
                                }
                            }
                        }
                        ThemedButton {
                            text: "Save Changes";
                            enabled: root.has-image;
                            clicked => { root.save-exif-changes(); }
                        }
                    }

                    Rectangle {
                        clip: true;
                        vertical-stretch: 1;
                        border-width: 1px;
                        border-color: root.border-color;
                        border-radius: 4px;
                        background: root.surface-color;

                        ListView {
                            for row[idx] in root.exif-model: HorizontalLayout {
                                height: 28px;
                                spacing: 8px;
                                padding-left: 4px;
                                padding-right: 4px;

                                Rectangle {
                                    width: 180px;
                                    clip: true;
                                    Text {
                                        text: row.tag;
                                        font-weight: row.is-common ? 700 : 400;
                                        color: root.text-color;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        overflow: elide;
                                    }
                                }

                                Rectangle {
                                    clip: true;
                                    horizontal-stretch: 1;

                                    ThemedLineEdit {
                                        text: row.value;
                                        edited(new-text) => {
                                            root.exif-value-edited(idx, new-text);
                                        }
                                        width: parent.width;
                                    }
                                }

                                Rectangle {
                                    width: 28px;
                                    height: 28px;
                                    border-radius: 4px;
                                    border-width: 1px;
                                    border-color: del-touch.pressed ? Theme.accent-color : (del-touch.has-hover ? Theme.accent-color : Theme.border-color);
                                    background: del-touch.pressed ? Theme.accent-color : (del-touch.has-hover ? Theme.preview-bg : Theme.surface-color);

                                    Text {
                                        text: "✕";
                                        color: del-touch.pressed ? #ffffff : Theme.text-color;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: parent.width;
                                        height: parent.height;
                                    }

                                    del-touch := TouchArea {
                                        clicked => {
                                            root.exif-tag-deleted(idx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Encryption section for Single Image
                if root.single-sub-mode == 1: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    Text {
                        text: "AES-256 Encryption & Steganography Embedding";
                        font-weight: 700;
                        color: root.text-color;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Method:"; color: root.text-color; vertical-alignment: center; width: 100px; }
                        ThemedDropdown {
                            model: root.steg-method-names;
                            current-index <=> root.steg-method-index;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Secret Text:"; color: root.text-color; vertical-alignment: center; width: 100px; }
                        ThemedLineEdit {
                            text <=> root.steg-secret-text;
                            placeholder-text: "Enter secret message to encrypt and hide…";
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Passphrase:"; color: root.text-color; vertical-alignment: center; width: 100px; }
                        ThemedLineEdit {
                            text <=> root.steg-passphrase;
                            placeholder-text: "Enter AES-256 encryption password…";
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        ThemedButton {
                            text: "Encrypt & Embed";
                            enabled: root.has-image;
                            clicked => { root.steg-embed(); }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                    }
                }

                // Decryption section for Single Image
                if root.single-sub-mode == 2: VerticalLayout {
                    spacing: 8px;
                    vertical-stretch: 1;

                    Text {
                        text: "Steganography Extraction & AES-256 Decryption";
                        font-weight: 700;
                        color: root.text-color;
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Method:"; color: root.text-color; vertical-alignment: center; width: 100px; }
                        ThemedDropdown {
                            model: root.steg-method-names;
                            current-index <=> root.steg-method-index;
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "Passphrase:"; color: root.text-color; vertical-alignment: center; width: 100px; }
                        ThemedLineEdit {
                            text <=> root.steg-passphrase;
                            placeholder-text: "Enter AES-256 decryption password…";
                            horizontal-stretch: 1;
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        ThemedButton {
                            text: "Extract & Decrypt";
                            enabled: root.has-image;
                            clicked => { root.steg-extract(); }
                        }
                    }

                    Text { text: "Extracted Message / Output Result:"; color: root.text-color; font-weight: 600; }

                    Rectangle {
                        clip: true;
                        vertical-stretch: 1;
                        border-width: 1px;
                        border-color: root.border-color;
                        border-radius: 4px;
                        background: root.surface-color;

                        VerticalLayout {
                            padding: 8px;
                            TextInput {
                                text <=> root.steg-output-text;
                                color: root.text-color;
                                font-size: 13px;
                                read-only: true;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }

            // ── Mode 1: Multiple Images Workspace (Batch) ─────────────
            if root.work-mode == 1: VerticalLayout {
                spacing: 8px;
                vertical-stretch: 1;

                Text { text: "Batch Processing Operations"; font-weight: 700; color: root.text-color; }

                HorizontalLayout {
                    spacing: 6px;
                    ThemedButton { text: "Add Images";  clicked => { root.request-open-images(); } }
                    ThemedButton { text: "Clear List";  clicked => { root.clear-batch-list(); } }
                    ThemedButton { text: "Start Batch"; clicked => { root.start-batch-process(); } }
                }

                ThemedCheckBox { text: "Preserve originals"; checked <=> root.batch-preserve-original; }

                Text { text: "Queue:"; color: root.text-color; font-weight: 600; }

                Rectangle {
                    clip: true;
                    height: 120px;
                    border-width: 1px;
                    border-color: root.border-color;
                    border-radius: 4px;
                    background: root.surface-color;

                    ListView {
                        height: parent.height;
                        for item in root.batch-model: Rectangle {
                            height: 24px;
                            width: parent.width;
                            clip: true;
                            Text {
                                text: item;
                                color: root.text-color;
                                vertical-alignment: center;
                                overflow: elide;
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                            }
                        }
                    }
                }

                Text { text: "Results:"; color: root.text-color; font-weight: 600; }

                Rectangle {
                    clip: true;
                    vertical-stretch: 1;
                    border-width: 1px;
                    border-color: root.border-color;
                    border-radius: 4px;
                    background: root.surface-color;

                    ListView {
                        height: parent.height;
                        for item in root.batch-status-model: Rectangle {
                            height: 24px;
                            width: parent.width;
                            clip: true;
                            Text {
                                text: item;
                                color: root.text-color;
                                vertical-alignment: center;
                                overflow: elide;
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                            }
                        }
                    }
                }
            }

            // ── Status bar ────────────────────────────────────────────
            Rectangle {
                height: 32px;
                border-width: 1px;
                border-color: root.border-color;
                border-radius: 4px;
                background: root.surface-color;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 8px;
                    alignment: space-between;

                    Rectangle {
                        horizontal-stretch: 1;
                        TextInput {
                            text <=> root.status-message;
                            color: root.text-color;
                            font-size: 13px;
                            vertical-alignment: center;
                            read-only: true;
                            width: parent.width;
                            height: parent.height;
                        }
                    }

                    if root.batch-progress > 0.0 && root.batch-progress < 1.0: Rectangle {
                        width: 120px;
                        height: 14px;
                        background: root.border-color;
                        border-radius: 7px;
                        Rectangle {
                            x: 0;
                            width: parent.width * root.batch-progress;
                            height: parent.height;
                            background: root.accent-color;
                            border-radius: 7px;
                        }
                    }
                }
            }
        }
    }

    // Modal popup dialog for maximized image view
    if root.show-maximized-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000a;
        z: 100;

        TouchArea {
            clicked => {
                root.show-maximized-dialog = false;
            }
        }

        Rectangle {
            width: root.width * 0.85;
            height: root.height * 0.85;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.surface-color;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.border-color;
            clip: true;

            VerticalLayout {
                padding: 12px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text {
                        text: root.current-file-name;
                        font-weight: 700;
                        color: root.text-color;
                        font-size: 15px;
                        vertical-alignment: center;
                    }
                    ThemedButton {
                        text: "Close";
                        clicked => {
                            root.show-maximized-dialog = false;
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: #111;
                    border-radius: 4px;
                    clip: true;

                    Image {
                        source: root.maximized-preview-source;
                        width: parent.width;
                        height: parent.height;
                        image-fit: contain;
                    }
                }
            }
        }
    }

    // Modal popup dialog for delete EXIF confirmation
    if root.show-delete-exif-dialog: Rectangle {
        width: 100%;
        height: 100%;
        background: #000a;
        z: 100;

        TouchArea {
            clicked => {
                root.show-delete-exif-dialog = false;
            }
        }

        Rectangle {
            width: 400px;
            height: 180px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: root.surface-color;
            border-radius: 8px;
            border-width: 1px;
            border-color: root.border-color;
            clip: true;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: "Confirm Delete EXIF";
                    font-weight: 700;
                    color: root.text-color;
                    font-size: 16px;
                }

                Text {
                    text: "Are you sure you want to delete all EXIF metadata from this image? This action cannot be undone.";
                    color: root.text-muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    ThemedButton {
                        text: "Cancel";
                        clicked => {
                            root.show-delete-exif-dialog = false;
                        }
                    }

                    Rectangle {
                        height: 30px;
                        min-width: 80px;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: confirm-touch.pressed ? #b91c1c : #ef4444;
                        background: confirm-touch.pressed ? #991b1c : #ef4444;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: "Delete";
                                color: #ffffff;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        confirm-touch := TouchArea {
                            clicked => {
                                root.show-delete-exif-dialog = false;
                                root.delete-exif();
                            }
                        }
                    }
                }
            }
        }
    }
}
