export global Theme {
    in-out property <string> theme-mode: "dark";
    in-out property <color> bg-color: #121212;
    in-out property <color> surface-color: #1e1e1e;
    in-out property <color> text-color: #e0e0e0;
    in-out property <color> text-muted: #a0a0a0;
    in-out property <color> border-color: #333333;
    in-out property <color> accent-color: #3b82f6;
    in-out property <color> preview-bg: #181818;
}
