import { Theme } from "theme.slint";

export component ThemedButton inherits Rectangle {
    in property <string> text: "";
    in property <bool> enabled: true;
    callback clicked();

    height: 30px;
    min-width: 80px;
    border-radius: 4px;
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-color : (touch.pressed ? Theme.accent-color : (touch.has-hover ? Theme.accent-color : Theme.border-color));
    background: !root.enabled ? Theme.preview-bg : (touch.pressed ? Theme.accent-color : (touch.has-hover ? Theme.preview-bg : Theme.surface-color));

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: !root.enabled ? Theme.text-muted : (touch.pressed ? #ffffff : Theme.text-color);
            font-size: 13px;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ThemedDropdown inherits Rectangle {
    in property <[string]> model: [];
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    callback selected(int);

    height: 30px;
    min-width: 120px;
    border-radius: 4px;
    border-width: 1px;
    border-color: !root.enabled ? Theme.border-color : (touch.has-hover ? Theme.accent-color : Theme.border-color);
    background: !root.enabled ? Theme.preview-bg : (touch.has-hover ? Theme.preview-bg : Theme.surface-color);

    property <int> visible-items: min(6, model.length);
    property <string> current-label: (current-index >= 0 && current-index < model.length) ? model[current-index] : "";

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Text {
            text: root.current-label;
            color: !root.enabled ? Theme.text-muted : Theme.text-color;
            font-size: 13px;
            horizontal-stretch: 1;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: popup.is-open ? "▴" : "▾";
            color: !root.enabled ? Theme.text-muted : Theme.text-color;
            font-size: 12px;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: max(root.width, 120px);
        height: root.visible-items * 28px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Theme.surface-color;
            border-width: 1px;
            border-color: Theme.border-color;
            border-radius: 4px;
            drop-shadow-color: #0006;
            drop-shadow-blur: 8px;

            VerticalLayout {
                padding: 4px;
                for value[index] in root.model : Rectangle {
                    height: 26px;
                    border-radius: 3px;
                    background: (index == root.current-index) ? Theme.accent-color : (item-touch.has-hover ? Theme.preview-bg : transparent);
                    Text {
                        text: value;
                        color: (index == root.current-index) ? #ffffff : Theme.text-color;
                        font-size: 13px;
                        x: 8px;
                        width: parent.width - 16px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.selected(index);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

export component ThemedCheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text: "";

    height: 24px;
    HorizontalLayout {
        spacing: 8px;
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 3px;
            border-width: 1px;
            border-color: Theme.border-color;
            background: checked ? Theme.accent-color : Theme.surface-color;

            if checked: Text {
                text: "✓";
                color: #ffffff;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }
        Text {
            text: root.text;
            color: Theme.text-color;
            vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.checked = !root.checked;
        }
    }
}

export component ThemedLineEdit inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    callback edited(string);

    height: 30px;
    border-radius: 4px;
    border-width: 1px;
    border-color: Theme.border-color;
    background: Theme.surface-color;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        TextInput {
            text <=> root.text;
            color: Theme.text-color;
            vertical-alignment: center;
            font-size: 13px;
            edited() => { root.edited(root.text); }
        }
    }
}
